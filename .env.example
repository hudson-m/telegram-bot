# --- Obrigatórias ---
TELEGRAM_BOT_TOKEN=seu_token_aqui
# Seu ID no Telegram (use /myid no bot). Só esse usuário é atendido.
TELEGRAM_USER_ID=seu_id_telegram
ANTHROPIC_API_KEY=sua_chave_aqui
# Transcrição de áudio (Whisper)
GROQ_API_KEY=sua_chave_aqui
# Busca na web
TAVILY_API_KEY=sua_chave_aqui
# Places API (busca de lugares próximos)
GOOGLE_MAPS_API_KEY=sua_chave_aqui
# JSON da service account em uma linha; compartilhe os calendários com o e-mail dela
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Google Calendar ---
# ID do calendário principal (obrigatório). Os demais são opcionais.
CALENDAR_PRINCIPAL=seu_email@gmail.com
CALENDAR_SAUDE=
CALENDAR_TRABALHO=
CALENDAR_AULAS=

# --- Painel web (passkeys) ---
# Domínio e origem públicos do painel. Em produção use https.
WEBAPP_DOMAIN=localhost
WEBAPP_ORIGIN=http://localhost:8000
# Assina cookies de sessão e tokens de setup. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Chave Fernet para criptografar notas. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Opcionais ---
DB_PATH=history.db
REMINDER_MINUTES=30
PORT=8000
